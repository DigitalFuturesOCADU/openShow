---
import { Image } from 'astro:assets'
import { projectPath } from '../lib/slugs'
import { resolveImage } from '../lib/images'
import { featuredImage, altFor, label } from '../lib/site'

interface Props { projects: any[]; showYear?: boolean }
const { projects, showYear = false } = Astro.props
---
<ul class="tiles">
  {projects.map((p) => {
    const f = featuredImage(p)
    const img = f?.type === 'image' ? resolveImage(f.file) : null
    const total = p.data.media.filter((m: any) => m.type === 'image').length
    return (
      <li>
        <a href={projectPath(p.data.slug)}>
          <div class="frame">
            {img
              ? <Image src={img} alt={altFor(p.data.title, f?.type === 'image' ? f.alt : null, 0, total)}
                       widths={[320, 640]} sizes="(max-width: 40rem) 50vw, 20rem" loading="lazy" />
              : <div class="placeholder" aria-hidden="true"></div>}
          </div>
          <div class="cap">
            <h3>{p.data.title}</h3>
            {p.data.creditsRaw && <p class="by">{p.data.creditsRaw}</p>}
            <p class="label">
              {showYear && p.data.year}{showYear && p.data.medium.length > 0 && ' · '}
              {p.data.medium.map((m: string) => label('medium', m)).join(' · ')}
            </p>
          </div>
        </a>
      </li>
    )
  })}
</ul>

<style>
  .tiles { list-style: none; padding: 0; margin: 0;
           display: grid; gap: 1.75rem var(--tile-gap);
           grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr)); }
  .tiles a { text-decoration: none; display: block; }
  .frame { aspect-ratio: 1; overflow: hidden; background: var(--rule); }
  .frame :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .placeholder { width: 100%; height: 100%; }
  .cap { padding: .5rem .25rem 0; }
  h3 { font-size: .9375rem; font-weight: 500; margin: 0 0 .1rem; line-height: 1.3; }
  .by { margin: 0 0 .15rem; font-size: .8125rem; color: var(--muted); }
  .cap .label { margin: 0; }
  .tiles a:hover h3 { text-decoration: underline; }
</style>
