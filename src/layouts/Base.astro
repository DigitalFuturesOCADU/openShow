---
import '../styles/theme.css'
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'
import logo from '../assets/open-show-logo.png'
import { label as mediumLabelOf } from '../lib/site'

const mediumLabel = (slug: string) => mediumLabelOf('medium', slug)

interface Props {
  title: string
  description?: string
  /** Show whose theme tokens should apply. Omit for archive-wide pages. */
  theme?: Record<string, string>
  /** Marks which nav item is current. */
  section?: string
  /** Absolute URL of an image to use as the social card. */
  ogImage?: string
}
const { title, description, theme, section, ogImage } = Astro.props

const base = import.meta.env.BASE_URL
const href = (p: string) => `${base}${p}`.replace(/([^:])\/{2,}/g, '$1/')

const shows = (await getCollection('shows')).sort(
  (a, b) => b.data.year - a.data.year || String(a.data.session).localeCompare(String(b.data.session)),
)
const current = shows.find((s) => s.data.current) ?? shows[0]

const projects = await getCollection('projects', (p) => p.data.status === 'publish')
const topicCounts = new Map<string, number>()
for (const p of projects) for (const m of p.data.medium) topicCounts.set(m, (topicCounts.get(m) ?? 0) + 1)
const topics = [...topicCounts]
  .map(([slug, count]) => ({ slug, count, label: mediumLabel(slug) }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label))

// Per-show tokens are applied as inline custom properties, so a show restyles
// itself without forking the template. Everything unset falls back to default.
const tokenStyle = theme
  ? Object.entries(theme).map(([k, v]) => `${k.startsWith('--') ? k : `--${k}`}:${v}`).join(';')
  : undefined
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    {/* The work is a better social card than anything generated around it —
        these are visual projects, and a composed card with a title over a
        gradient would say less than the photograph does. */}
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site ?? Astro.url).href} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="canonical" href={Astro.url.href} />
  </head>
  <body style={tokenStyle}>
    <a class="skip" href="#main">Skip to content</a>

    <div class="shell">
      <header class="sidebar">
        <a class="wordmark" href={href('')}>
          <Image src={logo} alt="Digital Futures Open Show" widths={[240, 480]} sizes="13rem" loading="eager" />
        </a>

        <nav aria-label="Main">
          <a href={href('about')} aria-current={section === 'about' ? 'page' : undefined}>What Is OPEN Show?</a>
        </nav>

        {/* A GET form, so it works before any script runs — the search page
            reads ?q= and runs the query. */}
        <form class="find" role="search" action={href('search')} method="get">
          <label class="sr" for="q">Search the archive</label>
          <input type="search" id="q" name="q" placeholder="Search" autocomplete="off" />
        </form>

        <nav class="group" aria-label="People">
          <a class="head" href={href('people')} aria-current={section === 'people' ? 'page' : undefined}>People</a>
        </nav>

        <nav class="group" aria-label="Shows">
          <a class="head" href={href(`shows/${current?.id ?? ''}`)}>Shows</a>
          <div>
            {shows.map((s) => (
              <a href={href(`shows/${s.id}`)} aria-current={section === `show:${s.id}` ? 'page' : undefined}>
                {s.data.title.replace('Open Show ', '')} <span class="n">{s.data.projectCount}</span>
              </a>
            ))}
          </div>
        </nav>

        <nav class="group" aria-label="Topics">
          <a class="head" href={href('topics')} aria-current={section === 'topics' ? 'page' : undefined}>Topics</a>
          <div>
            {topics.map((t) => (
              <a href={href(`topics/${t.slug}`)} aria-current={section === `topic:${t.slug}` ? 'page' : undefined}>
                {t.label} <span class="n">{t.count}</span>
              </a>
            ))}
          </div>
        </nav>
      </header>

      <main id="main"><slot /></main>
    </div>
  </body>
</html>

<style>
  .shell { display: block; }

  .sidebar {
    padding: 1.25rem var(--gutter) 2rem;
    border-bottom: 1px solid var(--rule);
  }
  /* The source PNG carried 70px of transparent margin on a 640px canvas — an
     11% inset that pushed the artwork out of line with the nav beneath it. The
     asset is trimmed to its bounding box, so its left edge is the artwork's
     left edge and both start at the same rule. */
  .wordmark { display: block; margin-bottom: 1.5rem; max-width: 10.5rem; }
  nav { display: flex; flex-direction: column; gap: .3rem; }
  nav a { text-decoration: none; font-size: .9375rem; }
  nav a[aria-current="page"] { font-weight: 700; }
  nav a:hover { text-decoration: underline; }

  .find { margin: 1.25rem 0; }
  .find input {
    width: 100%; font: inherit; font-size: .9375rem; color: inherit;
    background: none; border: 0; border-bottom: 1px solid var(--rule);
    padding: .3rem 0; border-radius: 0;
  }
  .find input:focus { outline: none; border-bottom-color: var(--ink); }
  .find input::placeholder { color: var(--muted); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

  .group { margin-top: 1.25rem; }
  .group > div { display: flex; flex-direction: column; gap: .25rem; margin-top: .4rem; }
  .group .head {
    font-size: .6875rem; letter-spacing: .09em; text-transform: uppercase;
    color: var(--muted); text-decoration: none;
  }
  .group .head:hover, .group .head[aria-current="page"] { color: var(--ink); }
  .group > div a { font-size: .875rem; }
  .group .n { color: var(--muted); font-size: .75rem; }

  /* On narrow screens the rail stacks above the content, so three vertical
     lists would push everything below the fold. Lay them out as scrollable
     rows instead — same links, a fraction of the height. */
  @media (max-width: 51.99rem) {
    nav[aria-label="Main"] { flex-direction: row; flex-wrap: wrap; gap: .3rem .9rem; }
    .group { margin-top: .9rem; }
    .group > div {
      flex-direction: row; gap: .9rem; overflow-x: auto; padding-bottom: .25rem;
      scrollbar-width: thin; -webkit-overflow-scrolling: touch;
    }
    .group > div a { white-space: nowrap; }
  }

  main { padding: 1.5rem var(--gutter) 5rem; min-width: 0; }

  /* The original theme's fixed left rail, kept for wide screens only. */
  @media (min-width: 52rem) {
    .shell { display: grid; grid-template-columns: var(--sidebar-width) minmax(0, 1fr); }
    .sidebar {
      position: sticky; top: 0; align-self: start; height: 100vh; overflow-y: auto;
      border-bottom: 0; border-right: 1px solid var(--rule); padding-top: 1.75rem;
    }
    main { padding: 1.75rem 2rem 6rem; }
  }
</style>
