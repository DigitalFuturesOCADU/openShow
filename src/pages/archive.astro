---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import Tiles from '../components/Tiles.astro'

// The full archive: everything, every year. Distinct from a show page, which
// carries one show's identity and only its work.
const projects = (await getCollection('projects', (p) => p.data.status === 'publish')).sort(
  (a, b) => (b.data.year ?? 0) - (a.data.year ?? 0) || a.data.title.localeCompare(b.data.title),
)
const shows = (await getCollection('shows')).sort((a, b) => b.data.year - a.data.year)
---
<Base title="Archive — Digital Futures Open Show" section="archive"
      description={`Every project from every OPEN Show — ${projects.length} works, 2019 to ${shows[0]?.data.year}.`}>
  <header class="head">
    <h1>Archive</h1>
    <p class="lede">{projects.length} projects across {shows.length} shows.</p>
  </header>
  <Tiles projects={projects} showYear={true} />
</Base>

<style>
  .head { margin-bottom: 1.5rem; }
  h1 { font-size: clamp(1.6rem, 3.5vw, 2.4rem); margin: 0 0 .2rem; letter-spacing: -.01em; }
  .lede { color: var(--muted); margin: 0; }
</style>
