---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import Tiles from '../components/Tiles.astro'
import { facetCounts } from '../lib/site'

// Re-slicing the archive by any axis was the point of splitting year,
// affiliation and medium apart. Filtering runs client-side over 240 projects,
// which needs no network and no build-time combinatorial explosion of pages.
const projects = (await getCollection('projects', (p) => p.data.status === 'publish')).sort(
  (a, b) => (b.data.year ?? 0) - (a.data.year ?? 0) || a.data.title.localeCompare(b.data.title),
)

const media = facetCounts(projects, 'medium')
const affiliations = facetCounts(projects, 'affiliation')
const years = [...new Set(projects.map((p) => p.data.year).filter(Boolean))].sort((a, b) => b! - a!)
---

<Base title="Browse — Digital Futures Open Show" description={`Filter ${projects.length} projects by medium, affiliation and year.`}>
  <h1>Browse</h1>
  <p class="lede">
    <output id="count" for="filters">{projects.length}</output> of {projects.length} projects.
    <button type="button" id="reset" hidden>Clear filters</button>
  </p>

  <form id="filters" aria-label="Filter projects">
    <fieldset>
      <legend>Year</legend>
      <div class="chips">
        {years.map((y) => (
          <label class="chip">
            <input type="checkbox" name="year" value={String(y)} />
            <span>{y}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset>
      <legend>Medium</legend>
      <div class="chips">
        {media.map((t) => (
          <label class="chip">
            <input type="checkbox" name="medium" value={t.slug} />
            <span>{t.label} <em>{t.count}</em></span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset>
      <legend>Affiliation</legend>
      <div class="chips">
        {affiliations.map((t) => (
          <label class="chip">
            <input type="checkbox" name="affiliation" value={t.slug} />
            <span>{t.label} <em>{t.count}</em></span>
          </label>
        ))}
      </div>
    </fieldset>
  </form>

  <div id="results">
    <Tiles projects={projects} showYear={true} filterable={true} />
  </div>

  <p id="empty" hidden role="status">No projects match those filters.</p>
</Base>

<script>
  const form = document.getElementById('filters') as HTMLFormElement
  const items = [...document.querySelectorAll<HTMLLIElement>('#results li')]
  const count = document.getElementById('count')!
  const empty = document.getElementById('empty')!
  const reset = document.getElementById('reset') as HTMLButtonElement

  const selected = (name: string) =>
    new Set([...form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)].map((i) => i.value))

  function apply() {
    const years = selected('year')
    const media = selected('medium')
    const affs = selected('affiliation')
    const any = years.size || media.size || affs.size
    let shown = 0

    for (const li of items) {
      const itemMedia = (li.dataset.medium ?? '').split(' ').filter(Boolean)
      const itemAffs = (li.dataset.affiliation ?? '').split(' ').filter(Boolean)
      // Within an axis, OR. Across axes, AND.
      const ok =
        (!years.size || years.has(li.dataset.year ?? '')) &&
        (!media.size || itemMedia.some((m) => media.has(m))) &&
        (!affs.size || itemAffs.some((a) => affs.has(a)))
      li.hidden = !ok
      if (ok) shown++
    }

    count.textContent = String(shown)
    empty.hidden = shown > 0
    reset.hidden = !any
  }

  form.addEventListener('change', apply)
  reset.addEventListener('click', () => { form.reset(); apply() })
  apply()
</script>

<style>
  h1 { font-size: clamp(1.75rem, 4vw, 2.75rem); margin: 0 0 .25rem; }
  .lede { color: var(--muted); margin: 0 0 1.5rem; }
  #reset { margin-left: .75rem; font: inherit; background: none; border: 1px solid var(--rule);
           border-radius: 999px; padding: .1rem .7rem; color: inherit; cursor: pointer; }
  form { border-top: 1px solid var(--rule); padding-top: 1.25rem; margin-bottom: 2.5rem; }
  fieldset { border: 0; padding: 0; margin: 0 0 1rem; }
  legend { font-size: .8125rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); padding: 0 0 .4rem; }
  .chips { display: flex; flex-wrap: wrap; gap: .4rem; }
  .chip input { position: absolute; opacity: 0; width: 0; height: 0; }
  .chip span { display: inline-block; border: 1px solid var(--rule); border-radius: 999px;
               padding: .15rem .7rem; font-size: .875rem; cursor: pointer; }
  .chip em { font-style: normal; color: var(--muted); font-size: .8em; }
  .chip input:checked + span { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .chip input:checked + span em { color: inherit; opacity: .7; }
  .chip input:focus-visible + span { outline: 2px solid currentColor; outline-offset: 2px; }
</style>
