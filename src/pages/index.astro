---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import Show from '../components/Show.astro'
import { PEOPLE } from '../lib/site'

// The front page IS the current show — the same page as /shows/<id>, not a
// variation on it. Which show that is comes from the `current` flag on the show
// record, so changing it is one line in config/overrides.yaml:
//
//   show:2026:
//     current: true
//
// scripts/publish.mjs --create sets it automatically and stands the previous
// show down, so in normal use nobody edits this by hand.
const shows = (await getCollection('shows')).sort((a, b) => b.data.year - a.data.year)
const current = shows.find((s) => s.data.current) ?? shows[0]

const projects = (await getCollection('projects', (p) => p.data.status === 'publish'))
  .filter((p) => p.data.show === current?.id)
  .sort((a, b) => a.data.title.localeCompare(b.data.title))

const credited = new Set(projects.flatMap((p) => p.data.credits.map((c) => c.personId)))
const exhibitors = PEOPLE
  .filter((person) => credited.has(person.id))
  .sort((a, b) => a.sortName.localeCompare(b.sortName))

const pages = await getCollection('pages')
const about = pages.find((p) => p.id === current?.data.aboutPage) ?? null
---

<Base
  title="Digital Futures Open Show"
  description={current?.data.statement ?? `${current?.data.title}. ${projects.length} works.`}
  theme={current?.data.theme.tokens}
  section={`show:${current?.id}`}
>
  <Show show={current} projects={projects} exhibitors={exhibitors} about={about} />
</Base>
