---
import Base from '../../layouts/Base.astro'
import { PEOPLE, label } from '../../lib/site'

// Sorted by sortName ("Family, Given"), which is the whole reason the registry
// computes one — WordPress had no person entity to sort at all.
const people = [...PEOPLE].sort((a, b) => a.sortName.localeCompare(b.sortName))
const base = import.meta.env.BASE_URL
const letters = [...new Set(people.map((p) => p.sortName[0]?.toUpperCase() ?? '#'))].sort()
---
<Base title="People — Digital Futures Open Show" description={`${people.length} creators across seven shows.`}>
  <h1>People</h1>
  <p class="lede">
    {people.length} creators, {people.filter((p) => p.projectCount > 1).length} of them in more than one show.
  </p>

  <nav class="alpha" aria-label="Jump to letter">
    {letters.map((l) => <a href={`#letter-${l}`}>{l}</a>)}
  </nav>

  {letters.map((l) => (
    <section>
      <h2 id={`letter-${l}`}>{l}</h2>
      <ul>
        {people.filter((p) => (p.sortName[0]?.toUpperCase() ?? '#') === l).map((p) => (
          <li>
            <a href={`${base}people/${p.id}`}>{p.name}</a>
            {p.kind === 'collective' && <span class="kind"> collective</span>}
            <span class="n">{p.projectCount}</span>
            <span class="aff">{p.affiliations.map((a) => label('affiliation', a)).join(', ')}</span>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>

<style>
  h1 { font-size: clamp(1.75rem, 4vw, 2.75rem); margin: 0 0 .25rem; }
  .lede { color: var(--muted); margin: 0 0 1.5rem; }
  .alpha { display: flex; flex-wrap: wrap; gap: .5rem; border-top: 1px solid var(--rule);
           border-bottom: 1px solid var(--rule); padding: .75rem 0; margin-bottom: 2rem; position: sticky; top: 0;
           background: var(--paper); }
  .alpha a { text-decoration: none; padding: .1rem .4rem; }
  h2 { font-size: 1.5rem; margin: 2rem 0 .5rem; scroll-margin-top: 4rem; }
  ul { list-style: none; padding: 0; margin: 0; columns: 2; column-gap: 2rem; }
  @media (min-width: 52rem) { ul { columns: 3; } }
  li { break-inside: avoid; padding: .2rem 0; font-size: .9375rem; }
  .kind, .n, .aff { color: var(--muted); font-size: .8125rem; }
  .n { margin-left: .4rem; }
  .aff { margin-left: .4rem; }
</style>
